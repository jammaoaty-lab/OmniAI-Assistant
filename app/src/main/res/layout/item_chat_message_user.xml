<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="@dimen/spacing_sm">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/chat_bubble_user"
        app:cardCornerRadius="@dimen/bubble_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardPreventCornerOverlap="false">

        <TextView
            android:id="@+id/tv_message_content"
            style="@style/Senta.TextView.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/spacing_xxxl"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md"
            android:textColor="@color/chat_bubble_user_text"
            android:textSize="@dimen/text_size_body"
            tools:text="你好，请帮我写一段代码" />

    </androidx.cardview.widget.CardView>

</LinearLayout>
