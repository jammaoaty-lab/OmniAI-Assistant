<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="@dimen/spacing_sm">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/chat_bubble_user"
        app:cardCornerRadius="@dimen/bubble_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minWidth="120dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_md">

            <ImageButton
                android:id="@+id/btn_voice_play"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_voice"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/surface" />

            <LinearLayout
                android:id="@+id/layout_waveform"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/icon_lg"
                android:orientation="horizontal">

                <View
                    android:layout_width="2dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:background="@color/surface" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_voice_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_size_caption"
                tools:text="0:12" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
