<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_conversation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            tools:text="关于量子计算的讨论" />

        <ImageView
            android:id="@+id/iv_pin"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginStart="@dimen/spacing_xs"
            android:contentDescription="@string/tab_chat"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/text_tertiary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_chat"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/text_tertiary"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_conversation_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="3分钟前" />

        <TextView
            android:id="@+id/tv_model_tag"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tag_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_tag_local"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:textColor="@color/surface"
            android:textSize="@dimen/text_size_tag"
            tools:text="本地" />

    </LinearLayout>

</LinearLayout>
