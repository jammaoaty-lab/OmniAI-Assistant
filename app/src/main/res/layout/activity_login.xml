<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xxxl"
        android:paddingBottom="@dimen/spacing_xxl">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Senta.TextView.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="登录以继续"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />

        <EditText
            android:id="@+id/input_account"
            style="@style/Senta.EditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:hint="@string/hint_phone_or_email"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/section_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/input_password"
                style="@style/Senta.EditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="忘记密码？"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_phone"
                style="@style/Senta.EditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="手机号"
                android:inputType="phone"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_code"
                    style="@style/Senta.EditText"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1"
                    android:hint="验证码"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_code"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:minWidth="100dp"
                    android:text="@string/btn_send_code"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_toggle_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:text="@string/switch_to_code_login"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            style="@style/Senta.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/btn_login" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_height"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:text="或"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_height"
                android:layout_weight="1"
                android:background="@color/divider" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_google"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Google"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_google" />

            <ImageView
                android:id="@+id/btn_wechat"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="WeChat"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_wechat" />

            <ImageView
                android:id="@+id/btn_qq"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="QQ"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_qq" />

            <ImageView
                android:id="@+id/btn_apple"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Apple"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_apple" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_switch_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="没有账号？创建你的AI空间"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>

</ScrollView>
