<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Senta" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:divider">@color/divider</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Senta.Splash" parent="Theme.Senta">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Senta.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Senta.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Senta.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Senta.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="Senta.EditText" parent="Widget.Material3.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Senta.TextView.Title" parent="Widget.Material3.TextView">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.6</item>
    </style>

    <style name="Senta.TextView.Subtitle" parent="Widget.Material3.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Senta.TextView.Body" parent="Widget.Material3.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.1</item>
    </style>

    <style name="Senta.TextView.Caption" parent="Widget.Material3.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Senta.TextView.Label" parent="Widget.Material3.TextView">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.8</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Senta.TextView.SectionTitle" parent="Widget.Material3.TextView">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.2</item>
    </style>

    <style name="Senta.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:thumbTint">@color/switch_thumb_color</item>
        <item name="android:trackTint">@color/switch_track_color</item>
    </style>

    <style name="Senta.QuickButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:background">@drawable/bg_quick_btn</item>
        <item name="android:textColor">@color/quick_btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Senta.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/Senta.TextView.SectionTitle</item>
    </style>

    <style name="Senta.MenuItem" parent="">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Senta.Credits.GhostButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">#4DFFFFFF</item>
        <item name="strokeColor">@android:color/white</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="Senta.VisionChip" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
    </style>

    <style name="Senta.CreditsBalance" parent="Widget.Material3.TextView">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
